{
  "name": "owly",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first pain observation journal for nonverbal children — FLACC scale check-ins, pattern insights, one-page doctor PDF. 100% on-device, EN/FR.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/titoude/owly.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
